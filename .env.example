# Server-only Places API (New) key. Never prefix this key with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Browser key restricted to Maps JavaScript API and allowed HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional. Reviews add the Enterprise + Atmosphere SKU; disabled by default.
GOOGLE_PLACES_REVIEWS_ENABLED=false

# Browser token used for map rendering, Directions, and Optimization API calls.
NEXT_PUBLIC_MAPBOX_TOKEN=
